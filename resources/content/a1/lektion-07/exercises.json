    {"key": "a1-l7-30", "section": "grammar", "type": "mc", "page": 62, "prompt": "Welcher Satz ist richtig?", "data": {"options": ["Lauf zur Josefstraße!", "Läuf zur Josefstraße!", "Laufst zur Josefstraße!"], "answer": "Lauf zur Josefstraße!", "explanation": "au → äu nicht im Imperativ; kein -st.", "translation": "Which sentence is correct?"}},
    {"key": "a1-l7-31", "section": "grammar", "type": "order", "page": 128, "prompt": "Höfliche Aufforderung: Bilden Sie den Satz.", "data": {"tokens": ["Kommt", "mich", "doch", "mal", "besuchen", "!"], "answer": "Kommt mich doch mal besuchen!", "translation": "Do come and visit me!"}},
    {"key": "a1-l7-32", "section": "grammar", "type": "order", "page": 128, "prompt": "Höfliche Aufforderung: Bilden Sie den Satz.", "data": {"tokens": ["Bringt", "doch", "bitte", "eure", "Gitarren", "mit", "!"], "answer": "Bringt doch bitte eure Gitarren mit!", "translation": "Please bring your guitars!"}},
    {"key": "a1-l7-33", "section": "grammar", "type": "order", "page": 128, "prompt": "Denk positiv! Bilden Sie den Satz.", "data": {"tokens": ["Nimm", "das", "Leben", "leicht", "!"], "answer": "Nimm das Leben leicht!", "translation": "Take life easy!"}},
    {"key": "a1-l7-34", "section": "grammar", "type": "mc", "page": 126, "prompt": "Höflich: „Erklären Sie das!“ →", "data": {"options": ["Können Sie das bitte erklären?", "Erklären Sie das jetzt!", "Du erklärst das."], "answer": "Können Sie das bitte erklären?", "explanation": "können + bitte macht die Bitte höflich.", "translation": "Politely: “Explain that!” →"}},
    {"key": "a1-l7-35", "section": "grammar", "type": "mc", "page": 126, "prompt": "Höflich: „Ich will Sie etwas fragen.“ →", "data": {"options": ["Darf ich Sie etwas fragen?", "Fragen Sie!", "Ich frage Sie."], "answer": "Darf ich Sie etwas fragen?", "translation": "Politely: “I want to ask you something.” →"}},
    {"key": "a1-l7-36", "section": "dialog", "type": "dialog", "page": 129, "prompt": "„Soll ich Kaffee holen?“ –", "data": {"options": ["Ja, gerne!", "Wie du willst, aber ich reite lieber.", "Das ist aus Seide.", "Nein, der Schrank ist weg."], "answer": "Ja, gerne!", "translation": "“Shall I get coffee?” – “Yes, please!”"}},
    {"key": "a1-l7-37", "section": "dialog", "type": "dialog", "page": 129, "prompt": "„Wollen wir anfangen?“ –", "data": {"options": ["Ja, fangen wir an!", "Ja, in der Schule.", "Das bedeutet „nicht früh“.", "Meine Hose ist blau."], "answer": "Ja, fangen wir an!", "translation": "“Shall we start?” – “Yes, let's start!”"}},
    {"key": "a1-l7-38", "section": "dialog", "type": "dialog", "page": 126, "prompt": "„Entschuldigen Sie, was bedeutet „spät“?“ –", "data": {"options": ["„Spät“ bedeutet „nicht früh“.", "Ja, gern. Am Samstag um 19.30 Uhr.", "In der Steinstraße.", "Natürlich, Heise."], "answer": "„Spät“ bedeutet „nicht früh“.", "translation": "“Excuse me, what does „spät“ mean?” – “„Spät“ means „not early“.”"}},
    {"key": "a1-l7-39", "section": "dialog", "type": "mc", "page": 129, "prompt": "Positiv oder negativ? – „Das sieht ja schrecklich aus!“", "data": {"options": ["negativ", "positiv"], "answer": "negativ", "explanation": "schrecklich = sehr schlecht.", "translation": "Positive or negative? – That looks terrible!"}},
